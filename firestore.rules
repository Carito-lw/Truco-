rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Users collection
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId)
        && incoming().uid == request.auth.uid
        && incoming().displayName is string && incoming().displayName.size() <= 100
        && incoming().email is string && incoming().email.size() <= 150
        && incoming().elo is number
        && incoming().chips is number;

      allow update: if isOwner(userId) && isValidId(userId)
        && incoming().uid == existing().uid
        && incoming().displayName is string && incoming().displayName.size() <= 100
        && incoming().elo is number
        && incoming().chips is number;

      allow delete: if false;

      // Subcollection: Player Matches
      match /matches/{matchId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(matchId)
          && incoming().userId == request.auth.uid
          && incoming().scoreNosotros is number
          && incoming().scoreEllos is number
          && incoming().won is bool;
        allow update, delete: if false;
      }
    }

    // Rooms collection
    match /rooms/{roomId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(roomId)
        && incoming().hostUid == request.auth.uid
        && incoming().name is string && incoming().name.size() <= 120
        && incoming().points is number
        && incoming().bet is number
        && incoming().mode in ['1v1', '2v2', '3v3']
        && incoming().status in ['waiting', 'playing', 'finished'];

      allow update: if isSignedIn() && isValidId(roomId)
        && incoming().hostUid == existing().hostUid
        && incoming().name is string && incoming().name.size() <= 120
        && incoming().status in ['waiting', 'playing', 'finished'];

      allow delete: if isSignedIn() && resource.data.hostUid == request.auth.uid;
    }
  }
}
